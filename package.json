{
  "name": "hungry-snaily-math",
  "version": "1.0.0",
  "private": true,
  "description": "Hungry Snaily Math: offline math game for ages 6-8 (iPhone + iPad).",
  "scripts": {
    "patch": "python3 scripts/patch-prototypes.py",
    "vendor": "node scripts/vendor.mjs",
    "check": "node scripts/check-offline.mjs",
    "build": "npm run vendor && npm run check",
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "ios:add": "npx cap add ios",
    "ios:configure": "bash scripts/configure-ios.sh",
    "ios:sync": "npx cap sync ios",
    "screenshots": "node tools/screenshots.mjs",
    "test": "node tools/smoke-test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@fontsource/fredoka": "^5.0.0",
    "playwright": "^1.48.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
